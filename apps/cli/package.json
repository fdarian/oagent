{
	"name": "oagent",
	"version": "0.4.0",
	"type": "module",
	"private": false,
	"description": "MCP server that exposes ACP-compatible coding agents",
	"license": "Apache-2.0",
	"homepage": "https://github.com/fdarian/oagent",
	"repository": {
		"type": "git",
		"url": "https://github.com/fdarian/oagent.git",
		"directory": "apps/cli"
	},
	"engines": {
		"node": ">=18"
	},
	"bin": {
		"oagent": "./bin/oagent.mjs"
	},
	"files": [
		"bin",
		"README.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"build:binaries": "bun scripts/build-binaries.ts",
		"format": "biome check --write",
		"check:type": "tsc --noEmit",
		"check:lint": "biome check"
	},
	"devDependencies": {
		"@effect/platform-bun": "catalog:",
		"@modelcontextprotocol/server": "catalog:",
		"@oagent/config": "workspace:*",
		"@oagent/engine": "workspace:*",
		"@orpc/client": "catalog:",
		"@orpc/server": "catalog:",
		"@toon-format/toon": "^2.3.0",
		"@types/bun": "^1.3.13",
		"effect": "catalog:",
		"typescript": "catalog:"
	}
}
