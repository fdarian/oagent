{
	"name": "@oagent/monorepo",
	"version": "0.1.0",
	"private": true,
	"description": "MCP server that exposes OpenCode to Claude Code as a subagent (via ACP)",
	"license": "Apache-2.0",
	"packageManager": "pnpm@12.6.0",
	"scripts": {
		"check": "turbo run check",
		"format": "biome check --write",
		"build": "pnpm --filter oagent build",
		"ci:version": "changeset version",
		"ci:release": "changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@changesets/cli": "^2.29.7",
		"turbo": "^2.9.14"
	},
	"devEngines": {
		"runtime": {
			"name": "bun",
			"version": "latest",
			"onFail": "download"
		}
	}
}
